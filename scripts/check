#!/usr/bin/env bash
# Static validation for OmaPreflight: manifest, QML lint, and the security
# invariants documented in docs/security.md.
#
# Run from anywhere; operates on the repository root.
#
#   scripts/check              everything (needs Omarchy + qt6-declarative)
#   scripts/check --portable   only what runs anywhere: manifest sanity, the
#                              safety invariants, and the structural checks.
#                              This is what CI runs, where neither Omarchy nor
#                              Quickshell exists.
#
# Two things this script exists to get right:
#
#  1. qmllint and qmltestrunner ship in qt6-declarative but are NOT on PATH on
#     Omarchy. They live in /usr/lib/qt6/bin.
#
#  2. `qmllint -I "$OMARCHY_PATH/shell"` does NOT resolve `qs.Ui`/`qs.Commons`.
#     Quickshell maps the shell config *root* to the `qs` namespace, so the
#     import root must itself contain an entry named `qs`. We build that shim in
#     a temp dir — never inside the repo, because `omarchy plugin validate`
#     hard-fails on any symlink anywhere in the plugin folder.

set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
QT_BIN="${QT_BIN:-/usr/lib/qt6/bin}"
QML_IMPORTS="${QML_IMPORTS:-/usr/lib/qt6/qml}"

portable=0
[[ ${1:-} == --portable ]] && portable=1

status=0
note() { printf '\033[1m==>\033[0m %s\n' "$*"; }
fail() { printf '\033[31mFAIL\033[0m %s\n' "$*"; status=1; }
pass() { printf '\033[32m ok \033[0m %s\n' "$*"; }

# ---------------------------------------------------------------- manifest
# The authoritative check is the Omarchy validator. Where it is unavailable we
# re-assert the parts of the contract that can be checked with jq alone, so a
# pull request still cannot land a manifest that names an entry point which
# does not exist.
note "Validating the manifest"
if (( portable == 0 )) && command -v omarchy >/dev/null 2>&1; then
  if omarchy plugin validate "$REPO_ROOT"; then
    pass "omarchy plugin validate"
  else
    fail "omarchy plugin validate"
  fi
elif (( portable == 0 )); then
  fail "omarchy CLI not found; cannot validate the manifest"
else
  manifest="$REPO_ROOT/manifest.json"
  if ! jq -e . "$manifest" >/dev/null 2>&1; then
    fail "manifest.json is not valid JSON"
  else
    missing=$(jq -r '["schemaVersion","id","name","version","author","license","description","kinds","entryPoints"]
                     - (keys) | join(", ")' "$manifest")
    if [[ -n "$missing" ]]; then
      fail "manifest is missing required field(s): $missing"
    else
      pass "manifest has every required field"
    fi

    # The id is the plugin's permanent identity and the marketplace enforces
    # its shape; getting it wrong after publishing is not fixable.
    id=$(jq -r .id "$manifest")
    if [[ "$id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$id" != omarchy.* ]]; then
      pass "plugin id '$id' is well formed"
    else
      fail "plugin id '$id' is not a valid third-party id"
    fi

    entry_missing=0
    while IFS= read -r entry; do
      [[ -z "$entry" ]] && continue
      if [[ ! -f "$REPO_ROOT/$entry" ]]; then
        fail "entryPoints names a file that does not exist: $entry"
        entry_missing=1
      fi
    done < <(jq -r '.entryPoints | to_entries[] | .value' "$manifest")
    (( entry_missing == 0 )) && pass "every entry point exists on disk"
  fi
fi

# ------------------------------------------------------------------- lint
note "Linting QML"
if (( portable == 1 )); then
  pass "qmllint skipped (portable mode: Quickshell and the Omarchy shell are not present)"
elif [[ ! -x "$QT_BIN/qmllint" ]]; then
  fail "qmllint not found at $QT_BIN/qmllint (install qt6-declarative)"
else
  SHIM="$(mktemp -d -t omapreflight-lint-XXXXXX)"
  trap 'rm -rf -- "$SHIM"' EXIT
  ln -sfn "$OMARCHY_PATH/shell" "$SHIM/qs"

  mapfile -t qml_files < <(find "$REPO_ROOT" -name '*.qml' -not -path '*/.git/*' | sort)
  if (( ${#qml_files[@]} == 0 )); then
    fail "no QML files found"
  elif "$QT_BIN/qmllint" -I "$SHIM" -I "$QML_IMPORTS" "${qml_files[@]}"; then
    pass "qmllint (${#qml_files[@]} files)"
  else
    fail "qmllint"
  fi
fi

# ------------------------------------------------------------ safety grep
# Cheap, high-signal guards for the invariants in docs/security.md and
# ENGINEERING_SPEC §33. These catch an accidental regression long before a
# human review would, and they are the reason the security model can claim to
# be enforced rather than merely intended.
note "Checking safety invariants"
scan_paths=()
while IFS= read -r f; do scan_paths+=("$f"); done < <(
  find "$REPO_ROOT" \( -name '*.qml' -o -name '*.js' \) -not -path '*/.git/*' -not -path '*/tests/*'
)

# Guard: <description> <grep-args...>  — fails when the pattern matches.
guard() {
  local description="$1"; shift
  if grep -nE "$@" "${scan_paths[@]}"; then
    fail "$description"
  else
    pass "$description — clean"
  fi
}

if (( ${#scan_paths[@]} > 0 )); then
  # §23.4 / §33.1. The one legitimate mention is CommandRunner's refusal list,
  # which is why those lines carry an explicit marker comment.
  if grep -nE '(^|[^A-Za-z_])sudo[^A-Za-z_]' "${scan_paths[@]}" \
       | grep -v 'privilege-escalation denylist'; then
    fail "sudo referenced in plugin code (spec §33.1)"
  else
    pass "no sudo outside the refusal list"
  fi

  # CWE-78. There is no shell anywhere in the plugin, so there is nothing to
  # quote and nothing to escape.
  guard "no shell command construction (CWE-78)" '"(sh|bash|zsh|fish|dash)"[[:space:]]*,[[:space:]]*"-c"'

  # CWE-94. Turning any string into code is out of scope for a diagnostic tool,
  # and every string this plugin holds came from another program's output.
  guard "no dynamic code evaluation (CWE-94)" \
    '(^|[^A-Za-z_.])eval[[:space:]]*\(|new[[:space:]]+Function[[:space:]]*\(|Qt\.createQmlObject|Qt\.include'

  # §33.8/§33.9. MVP has no network behaviour at all; a report is written
  # locally and the user decides what to do with it.
  guard "no network access (§33.8)" \
    'XMLHttpRequest|fetch\(|Qt\.openUrlExternally|https?://[^"]*"[[:space:]]*\)'

  # A detached process outlives the runner, which means it escapes the timeout,
  # the output caps and cancellation all at once (CWE-770).
  guard "no detached processes" 'startDetached'

  # Structural invariant: exactly one file may start a process, and exactly one
  # may read a file. Everything else has to go through the hardened wrappers,
  # which is what makes the argument- and path-validation rules meaningful
  # rather than advisory.
  note "Checking the single-entry-point invariants"
  process_sites=$(grep -lE '^[[:space:]]*(property[[:space:]]+Process[[:space:]]+[A-Za-z_]+:[[:space:]]*)?Process[[:space:]]*\{' "${scan_paths[@]}" || true)
  if [[ "$process_sites" == "$REPO_ROOT/core/CommandJob.qml" || -z "$process_sites" ]]; then
    pass "Process is only instantiated in core/CommandJob.qml"
  else
    fail "Process instantiated outside core/CommandJob.qml:"$'\n'"$process_sites"
  fi

  # Writes are the only remaining FileView. Reads went through it until a
  # marketplace security review; they now use the command path, because FileView
  # offers no open flags, no file-type check and no size cap (docs/security.md
  # §5).
  fileview_sites=$(grep -lE '^[[:space:]]*(property[[:space:]]+FileView[[:space:]]+[A-Za-z_]+:[[:space:]]*)?FileView[[:space:]]*\{' "${scan_paths[@]}" | sort || true)
  if [[ "$fileview_sites" == "$REPO_ROOT/core/FileWriteJob.qml" || -z "$fileview_sites" ]]; then
    pass "FileView is only instantiated in core/FileWriteJob.qml"
  else
    fail "FileView instantiated outside core/FileWriteJob.qml:"$'\n'"$fileview_sites"
  fi

  # The read path only means anything if every read goes through it. `dd` is
  # how a file's contents are obtained, so it must be built in one place, where
  # the O_NOFOLLOW / O_NONBLOCK / byte-ceiling flags live together. Matched in
  # argv position: an occurrence of "dd" in a message is not an invocation.
  dd_sites=$(grep -lE '"dd"[[:space:]]*,' "${scan_paths[@]}" | sort || true)
  if [[ "$dd_sites" == "$REPO_ROOT/core/ReadPolicy.js" || -z "$dd_sites" ]]; then
    pass "the file-read command is only built in core/ReadPolicy.js"
  else
    fail "dd invoked outside core/ReadPolicy.js:"$'\n'"$dd_sites"
  fi

  # A read that follows symlinks is the finding this path exists to close, so
  # the flags are asserted rather than assumed.
  if grep -q 'iflag=nofollow,nonblock,fullblock,count_bytes' "$REPO_ROOT/core/ReadPolicy.js" \
     && grep -q 'stat", "-c", "%F|%s' "$REPO_ROOT/core/ReadPolicy.js"; then
    pass "reads are no-follow, non-blocking and byte-bounded, over a stat-checked type"
  else
    fail "core/ReadPolicy.js no longer opens reads with the documented flags"
  fi
fi

# --------------------------------------------------------- catalog drift
# A documented catalog that has drifted from the code is worse than none: it
# describes checks that no longer run and stays silent about ones that do. So
# the two are compared rather than trusted to stay in step.
note "Checking the catalog documentation against the code"
catalog_doc="$REPO_ROOT/docs/check-catalog.md"
if [[ ! -f "$catalog_doc" ]]; then
  fail "docs/check-catalog.md is missing"
else
  # Anchored on the `id:` property so a check id mentioned in prose, a fact
  # path like "hyprland.version", or a config filename like "hyprland.lua"
  # cannot be mistaken for a declaration. This is also why every check
  # definition is a literal object rather than something a factory builds.
  code_ids=$(grep -hoE '^  id: "[a-z][a-z0-9]*\.[a-z0-9-]+"' "$REPO_ROOT"/checks/*.js \
    | sed -E 's/.*"(.*)"/\1/' | sort -u)
  doc_ids=$(grep -oE '^### `[a-z][a-z0-9]*\.[a-z0-9-]+`' "$catalog_doc" \
    | sed -E 's/^### `(.*)`/\1/' | sort -u)

  undocumented=$(comm -23 <(echo "$code_ids") <(echo "$doc_ids"))
  phantom=$(comm -13 <(echo "$code_ids") <(echo "$doc_ids"))

  if [[ -n "$undocumented" ]]; then
    fail "checks with no entry in docs/check-catalog.md:"$'\n'"$undocumented"
  elif [[ -n "$phantom" ]]; then
    fail "docs/check-catalog.md documents checks that do not exist:"$'\n'"$phantom"
  else
    pass "check catalog matches the code ($(echo "$code_ids" | wc -l) checks)"
  fi
fi

# ------------------------------------------------------------ no symlinks
note "Checking for symlinks (the validator rejects them)"
if link=$(find "$REPO_ROOT" -name .git -prune -o -type l -print -quit); [[ -n ${link:-} ]]; then
  fail "symlink present: $link"
else
  pass "no symlinks"
fi

echo
if (( status == 0 )); then
  printf '\033[32mAll checks passed.\033[0m\n'
else
  printf '\033[31mChecks failed.\033[0m\n'
fi
exit $status
